# Crawl4AI Service Configuration

# Server settings
PORT=3001
LOGGING_LEVEL=INFO

# Database connection (NuQ PostgreSQL)
NUQ_DATABASE_URL=postgres://postgres:postgres@nuq-postgres:5432/postgres

# Worker settings
MAX_CONCURRENT_SCRAPES=5
LOCK_RENEW_INTERVAL=10
JOB_POLL_INTERVAL=0.5
MAX_BACKOFF_INTERVAL=10.0

# Engine marker - jobs with this engine value will be picked up
CRAWL4AI_ENGINE_MARKER=crawl4ai

# Browser settings
HEADLESS=true
BLOCK_MEDIA=false

# Proxy settings (optional)
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=
